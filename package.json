{
  "name": "everhue",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node tools/csp.mjs",
    "lint": "npm run lint:ts && npm run lint:style",
    "lint:ts": "tsc --noEmit",
    "lint:style": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:rules": "npm --prefix rules-tests test",
    "emulators": "npm --prefix rules-tests run emulators",
    "icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/make-icons.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "firebase": "13.0.0",
    "formik": "2.4.9",
    "i18next": "26.4.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "styled-components": "6.5.3",
    "yup": "1.7.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
