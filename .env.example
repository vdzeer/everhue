# Firebase web app config (Project settings → Your apps → Web app).
# These values are public identifiers, not secrets, but they still live in
# env files so dev and release can point at different projects.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 1 = talk to the local Auth and Firestore emulators (npm run emulators).
# Must be 0 in .env.production.
NEXT_PUBLIC_USE_EMULATORS=0

# Optional. A reCAPTCHA Enterprise site key (Google Cloud console,
# reCAPTCHA) turns on Firebase App Check, so requests carry a token that
# proves they come from this site. Empty leaves App Check off. It is never
# used with the emulators. See "App Check" in README.md.
NEXT_PUBLIC_APPCHECK_SITE_KEY=
